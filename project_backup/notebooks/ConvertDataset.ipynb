    "    },\n",
    "    'uit_valid_clean.xlsx': {\n",
    "        'text_columns': ['Sentence'],\n",
    "        'label_columns': ['Emotion']\n",
    "    },\n",
    "    'uit_test_clean.xlsx': {\n",
    "        'text_columns': ['Sentence'],\n",
    "        'label_columns': ['Emotion']\n",
    "    },\n",
    "    'vihsd_train_clean.xlsx': {\n",
    "        'text_columns': ['cmt_col'],\n",
    "        'label_columns': ['labels']\n",
    "    },\n",
    "    'vihsd_valid_clean.xlsx': {\n",
    "        'text_columns': ['cmt_col'],\n",
    "        'label_columns': ['labels']\n",
    "    },\n",
    "    'vihsd_test_clean.xlsx': {\n",
    "        'text_columns': ['cmt_col'],\n",
    "        'label_columns': ['labels']\n",
    "    }\n",
    "}\n",
    "\n",
    "for filename, cols in files_to_check.items():\n",
    "    filepath = os.path.join(data_dir, filename)\n",
    "    if os.path.exists(filepath):\n",
    "        check_nan_in_excel(filepath, \n",
    "                           text_columns=cols['text_columns'], \n",
    "                           label_columns=cols['label_columns'])\n",
    "    else:\n",
    "        print(f\"⚠️ Không tìm thấy file: {filepath}\")"
   ]
