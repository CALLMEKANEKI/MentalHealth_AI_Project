    "def check_nan_in_excel(file_path, sheet_name=0, text_columns=None, label_columns=None):\n",
    "    \"\"\"\n",
    "    file_path: đường dẫn file .xlsx\n",
    "    text_columns: list tên cột chứa văn bản (VD: ['Sentence', 'cmt_col'])\n",
    "    label_columns: list tên cột chứa nhãn (VD: ['Emotion', 'labels'])\n",
    "    \"\"\"\n",
    "    print(f\"\\n📁 Đang kiểm tra: {file_path}\")\n",
    "    df = pd.read_excel(file_path, sheet_name=sheet_name)\n",
    "    \n",
    "    if text_columns is None:\n",
    "        text_columns = []\n",
    "    if label_columns is None:\n",
    "        label_columns = []\n",
    "    \n",
    "    all_columns = text_columns + label_columns\n",
    "    if not all_columns:\n",
    "        # Nếu không chỉ định cột, kiểm tra tất cả\n",
    "        all_columns = df.columns.tolist()\n",
    "    \n",
    "    total_nan_rows = set()\n",
    "    for col in all_columns:\n",
    "        if col not in df.columns:\n",
    "            print(f\"⚠️ Cột '{col}' không tồn tại trong file. Bỏ qua.\")\n",
    "            continue\n",
    "        nan_mask = df[col].isna()\n",
    "        nan_indices = df.index[nan_mask].tolist()\n",
    "        if nan_indices:\n",
    "            print(f\"   ❌ Cột '{col}' có {len(nan_indices)} dòng NaN: {nan_indices}\")\n",
    "            total_nan_rows.update(nan_indices)\n",
    "        else:\n",
    "            print(f\"   ✅ Cột '{col}' không có NaN.\")\n",
    "    \n",
    "    if total_nan_rows:\n",
    "        print(f\"\\n📌 Tổng số dòng có ít nhất một NaN trong các cột đã chỉ định: {len(total_nan_rows)}\")\n",
    "        print(f\"   Các index: {sorted(total_nan_rows)}\")\n",
    "        # In thử 5 dòng đầu tiên bị lỗi\n",
    "        print(\"\\n🔍 Dữ liệu của các dòng bị lỗi (5 dòng đầu):\")\n",
    "        for idx in sorted(total_nan_rows)[:5]:\n",
    "            row = df.iloc[idx]\n",
    "            print(f\"   Index {idx}:\")\n",
    "            for col in all_columns:\n",
    "                if col in df.columns:\n",
    "                    print(f\"      {col}: {row[col]}\")\n",
    "        return df, sorted(total_nan_rows)\n",
    "    else:\n",
    "        print(\"✅ Không phát hiện NaN.\")\n",
    "        return df, []\n",
    "\n",
    "# Đường dẫn tới thư mục data của bạn (thay đổi cho phù hợp)\n",
    "project_root = r\"C:\\Users\\ASPIRE A715 - 42G\\Downloads\\MentalHealth_AI_Project\"  # Ví dụ\n",
    "data_dir = os.path.join(project_root, 'data', 'processed')\n",
    "\n",
    "# Các file cần kiểm tra\n",
    "files_to_check = {\n",
    "    'uit_train_clean.xlsx': {\n",
    "        'text_columns': ['Sentence'],\n",
